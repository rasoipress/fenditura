{
  "name": "fenditura",
  "productName": "Fenditura",
  "version": "1.0.2",
  "description": "Slit-scan scanning bench: turns a video into one continuous strip photograph",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rasoipress/fenditura.git"
  },
  "keywords": [
    "slit-scan",
    "strip-photography",
    "photo-finish",
    "video",
    "electron"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "icon": "python3 build/make-icon.py",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:all": "electron-builder --mac --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^24.1.0",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "org.fenditura.app",
    "productName": "Fenditura",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Fenditura ${version}${arch}"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Fenditura"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Graphics",
      "icon": "build/icon.png"
    }
  }
}
